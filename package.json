{
  "name": "mirai",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm codegen && alchemy dev",
    "dev:reference": "alchemy dev --stage reference",
    "build": "turbo run build",
    "check": "pnpm codegen && vp check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "typecheck": "tsrs --noEmit -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "deploy": "alchemy deploy --stage prod",
    "codegen": "pnpm --filter @mirai/web codegen"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/workers-types": "5.20261116.1",
    "@mirai/rpc": "workspace:*",
    "@types/node": "26.6.6",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4",
    "lefthook": "2.2.2",
    "tsrs": "7.1.0-beta.tsrs2",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.0.0"
}
