#!/usr/bin/env bash
set -euo pipefail

node_major="$(cut -d. -f1 .node-version 2>/dev/null || echo 26)"
node_major="${node_major:-26}"
node_major="${node_major#v}"
current_major="$(node --version 2>/dev/null | sed 's/^v//' | cut -d. -f1 || true)"

if [[ -z "$current_major" ]]; then
  echo 'Node.js is missing. Run .agents/setup.' >&2
  exit 1
fi

if [[ "$current_major" != "$node_major" ]]; then
  echo "Node.js $(node --version) is running; this repo needs $node_major. Run .agents/setup." >&2
  exit 1
fi

if [[ "$(pnpm --version 2>/dev/null || true)" != '12.0.0' ]]; then
  echo 'pnpm 12.0.0 is missing. Run .agents/setup.' >&2
  exit 1
fi

if [[ ! -x node_modules/.bin/tsrs ]]; then
  echo 'Workspace dependencies are missing. Run .agents/setup.' >&2
  exit 1
fi

# Repair state that a paused orb can lose without reinstalling dependencies.
if [[ -x node_modules/.bin/lefthook ]]; then
  node_modules/.bin/lefthook install >/dev/null
fi

echo "Orb ready: Node $(node --version), pnpm $(pnpm --version)."
